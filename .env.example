# S3 Bucket Credentials
S3_ACCESS= # e.g. "local"
S3_SECRET= # e.g. "local"
S3_ENDPOINT= # e.g. "http://localhost:9000"
S3_BUCKET_AVATARFILES= # e.g. my-bucket
S3_BUCKET_AVATARFILES_TEMP= # e.g. my-bucket-tmp
# Agent Session Manager (native username/password auth)
# NUXT_SESSION_PASSWORD encrypts the agent session cookie (nuxt-auth-utils); it is
# NOT used for hashing account passwords (those use Bun.password / argon2id).
NUXT_SESSION_PASSWORD= # Generate a long random string for this one!
# Legacy Auth0 vars - unused by the native auth system, kept only if server/api/auth/auth0.ts is still wired up
NUXT_OAUTH_AUTH0_CLIENT_ID=
NUXT_OAUTH_AUTH0_CLIENT_SECRET=
NUXT_OAUTH_AUTH0_DOMAIN=
# Public Session Manager (Discord OAuth)
NUXT_FRONTOFFICE_OAUTH_DISCORD_CLIENT_ID=
NUXT_FRONTOFFICE_OAUTH_DISCORD_CLIENT_SECRET=
NUXT_FRONTOFFICE_SESSION_PASSWORD= # Generate a long random string for this one!
# Dashboard settings
NUXT_BACKOFFICE_SKIP_ROLES=false # Should app check for user's role/permissions
NUXT_BACKOFFICE_MONGO_DB= # Mongo DB name
NUXT_BACKOFFICE_MONGO= # Mongo connection URL (for local, you can use mongodb://local:local@localhost:27020/redflare)
NUXT_BACKOFFICE_SERVICE= # Random string, used as token for external services apps (Geisha)
# Infisical
INFISICAL_SITE_URL= # e.g. "http://localhost:7001/"
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
# General
NUXT_PUBLIC_REDFLARE_ENV= # development | staging | production | etc...
NUXT_PORT= # 3000 by default